# MCP-LLM Gateway environment configuration
# Copy this file to /etc/mcp-llm-gateway/mcp-llm-gateway.env and fill in your values.
# Only one LLM_PROVIDER should be active at a time.

# ── Gateway settings ──────────────────────────────────────────────────────────
# API key that OpenSearch ML Commons sends in the X-API-Key header.
# Must match the credential.api_key value in the registered ML model connector.
GATEWAY_API_KEY="YOUR_GATEWAY_API_KEY_HERE"

# Port the FastAPI gateway listens on (default: 9912)
PORT=9912

# Set to "true" to enable verbose debug logging
VERBOSE="true"

# ── MCP Server connection ─────────────────────────────────────────────────────
# SSE endpoint of the OpenSearch MCP Server
# Example: http://127.0.0.1:9900/sse
MCP_SSE_URL="http://YOUR_MCP_SERVER_IP_HERE:9900/sse"

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported values: groq | openai | gemini | claude_bedrock
LLM_PROVIDER="gemini"

# ── Groq (set LLM_PROVIDER=groq to use) ──────────────────────────────────────
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY="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"
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL="llama-3.3-70b-versatile"

# ── OpenAI (set LLM_PROVIDER=openai to use) ──────────────────────────────────
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
OPENAI_MODEL="gpt-4o"

# ── Google Gemini (set LLM_PROVIDER=gemini to use) ───────────────────────────
GEMINI_API_KEY="AIzaSyBODTqBPDUiCCIs1kxm0B-0LdamWMhaqLI"
GEMINI_MODEL="gemini-2.5-flash"

# ── AWS Bedrock (set LLM_PROVIDER=claude_bedrock to use) ─────────────────────
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="anthropic.claude-3-sonnet-20240229-v1:0"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID_HERE"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY_HERE"

# ── Index settings (optional — defaults shown) ────────────────────────────────
ALERTS_INDEX="wazuh-alerts-*"
VULN_INDEX="wazuh-states-vulnerabilities-*"
DEFAULT_TIME_WINDOW="now-30m"
