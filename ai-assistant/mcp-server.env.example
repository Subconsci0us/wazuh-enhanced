# MCP Server environment configuration
# Copy this file to /etc/mcp-server/mcp-server.env and fill in your values.
# This file configures the OpenSearch MCP Server's connection to the Wazuh Indexer.

# ── Wazuh Indexer (OpenSearch) connection ─────────────────────────────────────
# Full HTTPS URL of the Wazuh Indexer REST API
OPENSEARCH_URL="https://YOUR_WAZUH_INDEXER_HOST_HERE:9200"

# Indexer admin credentials
OPENSEARCH_USERNAME="YOUR_INDEXER_USERNAME_HERE"
OPENSEARCH_PASSWORD="YOUR_INDEXER_PASSWORD_HERE"

# Set to "false" to disable SSL certificate verification (self-signed certs)
OPENSEARCH_SSL_VERIFY="false"
