# NLQ Search Plugin — environment variable template
# Copy this file to .env and fill in the values before running install.sh
# The install script reads this file and writes it to the plugin's config.

# ── LLM Backend ───────────────────────────────────────────────────────────────
# Which backend to use: "groq", "gemini", or "ollama"
# If unset, the plugin auto-detects: Groq if GROQ_API_KEY is set,
# then Gemini if GEMINI_API_KEY is set, otherwise Ollama at localhost:11434.
NLQ_BACKEND=groq

# ── Groq API (backend=groq) ───────────────────────────────────────────────────
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Groq model to use (default: llama-3.3-70b-versatile)
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gemini API (backend=gemini) ───────────────────────────────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ── Ollama (backend=ollama) ───────────────────────────────────────────────────
# Base URL of your Ollama server (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Default model for Ollama (must be pulled: `ollama pull phi3.5`)
OLLAMA_MODEL=phi3.5
