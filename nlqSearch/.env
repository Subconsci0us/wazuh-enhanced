# NLQ Search Plugin — active environment configuration
# Sourced by install.sh when present (takes precedence over exported env vars).

# ── LLM Backend ───────────────────────────────────────────────────────────────
NLQ_BACKEND=gemini

# ── Groq API ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=ADD_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gemini API (active provider) ──────────────────────────────────────────────
GEMINI_API_KEY=ADD_HERE
GEMINI_MODEL=gemini-2.5-flash

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3.5
