{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sec-IR",
  "description": "Security-Semantic Intermediate Representation schema v1.0",
  "type": "object",
  "required": ["sec_ir_version", "event_type", "pattern", "entity", "severity", "time_range"],
  "additionalProperties": false,
  "properties": {
    "sec_ir_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "authentication_failure",
        "privilege_escalation",
        "lateral_movement",
        "port_scan",
        "process_injection",
        "file_deletion",
        "malware_alert",
        "ransomware_behavior",
        "policy_violation",
        "data_exfiltration"
      ]
    },
    "pattern": {
      "type": "string",
      "enum": ["single_event", "repeated_attempts", "spike", "sequence", "absence"]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user":         { "type": "string" },
        "user_role":    { "type": "string" },
        "src_ip":       { "type": "string" },
        "host":         { "type": "string" },
        "process":      { "type": "string" },
        "process_path": { "type": "string" },
        "command_line": { "type": "string" }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical", "any"]
    },
    "time_range": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type":  { "type": "string", "const": "relative" },
            "value": {
              "type": "string",
              "pattern": "^last_[0-9]+[mhd]$"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type":  { "type": "string", "const": "absolute" },
            "start": { "type": "string", "format": "date-time" },
            "end":   { "type": "string", "format": "date-time" }
          },
          "required": ["type", "start", "end"],
          "additionalProperties": false
        }
      ]
    },
    "aggregation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["threshold", "group_by"],
          "additionalProperties": false,
          "properties": {
            "threshold": { "type": "integer", "minimum": 1 },
            "group_by": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["user", "src_ip", "host", "process"]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "correlation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["events", "maxspan"],
          "additionalProperties": false,
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["event_type"],
                "additionalProperties": false,
                "properties": {
                  "event_type": { "type": "string" },
                  "entity":     { "type": "object" }
                }
              },
              "minItems": 2
            },
            "maxspan": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h|d)$"
            }
          }
        }
      ]
    },
    "analytics": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["source", "operations"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "sources": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "lets": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "expression"],
                "additionalProperties": false,
                "properties": {
                  "name":       { "type": "string", "minLength": 1 },
                  "expression": { "type": "string", "minLength": 1 }
                }
              }
            },
            "operations": {
              "type": "array",
              "items": { "$ref": "#/definitions/analytics_operation" }
            }
          }
        }
      ]
    }
  },
  "definitions": {
    "analytics_operation": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "where", "extend", "summarize", "project", "distinct",
            "sort", "order", "top", "limit", "take", "search",
            "join", "render", "mv_expand", "mv-expand"
          ]
        },
        "field":    { "type": "string" },
        "operator": { "type": "string" },
        "value": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "integer" },
            { "type": "boolean" },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "string" },
                  { "type": "number" },
                  { "type": "integer" },
                  { "type": "boolean" }
                ]
              }
            }
          ]
        },
        "alias":      { "type": "string" },
        "expression": { "type": "string" },
        "aggregations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["function"],
            "additionalProperties": false,
            "properties": {
              "alias":    { "type": "string" },
              "function": { "type": "string" },
              "field":    { "type": "string" }
            }
          }
        },
        "by": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field":     { "type": "string" },
              "direction": { "type": "string", "enum": ["asc", "desc"] }
            }
          }
        },
        "count":     { "type": "integer", "minimum": 1 },
        "direction": { "type": "string", "enum": ["asc", "desc"] },
        "kind":      { "type": "string" },
        "title":     { "type": "string" },
        "chart":     { "type": "string" },
        "on":        { "type": "string" },
        "source":    { "type": "string" },
        "subquery": {
          "type": "object",
          "required": ["source", "operations"],
          "additionalProperties": false,
          "properties": {
            "source":     { "type": "string" },
            "operations": {
              "type": "array",
              "items": { "$ref": "#/definitions/analytics_operation" }
            }
          }
        }
      }
    }
  }
}
