{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sec-IR",
  "description": "Security-Semantic Intermediate Representation schema v1.0",
  "type": "object",
  "required": ["sec_ir_version", "event_type", "pattern", "entity", "severity", "time_range"],
  "additionalProperties": false,
  "properties": {
    "sec_ir_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "authentication_failure",
        "privilege_escalation",
        "lateral_movement",
        "port_scan",
        "process_injection",
        "file_deletion",
        "malware_alert",
        "ransomware_behavior",
        "policy_violation",
        "data_exfiltration"
      ]
    },
    "pattern": {
      "type": "string",
      "enum": ["single_event", "repeated_attempts", "spike", "sequence", "absence"]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user":      { "type": "string" },
        "user_role": { "type": "string" },
        "src_ip":    { "type": "string" },
        "host":      { "type": "string" },
        "process":   { "type": "string" }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical", "any"]
    },
    "time_range": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type":  { "type": "string", "const": "relative" },
            "value": {
              "type": "string",
              "pattern": "^last_(1h|6h|12h|24h|7d|30d|90d)$"
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type":  { "type": "string", "const": "absolute" },
            "start": { "type": "string", "format": "date-time" },
            "end":   { "type": "string", "format": "date-time" }
          },
          "required": ["type", "start", "end"],
          "additionalProperties": false
        }
      ]
    },
    "aggregation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["threshold", "group_by"],
          "additionalProperties": false,
          "properties": {
            "threshold": { "type": "integer", "minimum": 1 },
            "group_by": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["user", "src_ip", "host", "process"]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "correlation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["events", "maxspan"],
          "additionalProperties": false,
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["event_type"],
                "additionalProperties": false,
                "properties": {
                  "event_type": { "type": "string" },
                  "entity":     { "type": "object" }
                }
              },
              "minItems": 2
            },
            "maxspan": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h|d)$"
            }
          }
        }
      ]
    }
  }
}
